# PostgreSQL connection used by Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# PayPal Sandbox REST app credentials
# NEXT_PUBLIC_ is intentionally limited to the public JavaScript SDK client ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_paypal_client_id
PAYPAL_CLIENT_ID=your_sandbox_paypal_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_paypal_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Server-side OpenAI judge and optional Zapier Catch Hook
OPENAI_API_KEY=sk-your_openai_api_key
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_hook_id/your_hook_token/
